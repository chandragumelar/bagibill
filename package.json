{
  "name": "bagibill",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-locale-keys.ts && node scripts/check-raw-css-values.ts && vite build",
